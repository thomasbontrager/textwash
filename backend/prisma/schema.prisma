generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleEnum {
  USER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum PermissionEnum {
  MANAGE_USERS
  MANAGE_PLANS
  MANAGE_FEATURE_FLAGS
  MANAGE_OAUTH
  VIEW_LOGS
  IMPERSONATE_USERS
  MANAGE_BILLING
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  USER
  GUEST
}

// Enum definitions
// Enums
enum RoleType {
  SUPER_ADMIN
  ADMIN
  MANAGER
  USER
  GUEST
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  PAUSED
  EXPIRED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  role          Role          @default(USER)
  status        UserStatus    @default(ACTIVE)
  stripeId      String?       @unique
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  subscription  Subscription?
  adminProfile  AdminProfile?
  apiKeys       ApiKey[]
  organization  Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  agentExecutions AgentExecution[]
  loginLogs     LoginLog[]
  
  @@index([status, email])
  @@index([deletedAt])
// User Model with soft delete
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  stripeId     String?   @unique
  role         Role      @default(USER)
  deletedAt    DateTime? // Soft delete support
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  subscriptions   Subscription[]
  adminProfile    AdminProfile?
  apiKeys         ApiKey[]
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  organizationId  String?
  agentExecutions AgentExecution[]
  aiUsageLogs     AIUsageLog[]
  loginLogs       LoginLog[]
  apiLogs         APILog[]
  sessions        Session[]

  @@index([email])
  @@index([deletedAt])
  @@index([organizationId])
}

